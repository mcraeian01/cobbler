# Template: setup.sh fills in @ROOT@ and installs this to ~/.config/systemd/user/.
[Unit]
Description=Cobbler agent cycle (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=%h/.config/agent-runner/env
ExecStart=/usr/bin/python3 @ROOT@/bin/cycle.py --mode %i
Nice=10
TimeoutStartSec=4h
