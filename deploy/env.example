# setup.sh writes this to ~/.config/agent-runner/env (chmod 600). Never commit the real one.
# From `claude setup-token`: a one-year token on your Claude Pro/Max subscription.
CLAUDE_CODE_OAUTH_TOKEN=paste-token-here
# Where the morning digest is pushed. A long random ntfy.sh topic name works as the password.
NTFY_URL=
# Optional, only for a self-hosted or protected ntfy topic.
# NTFY_TOKEN=
